<table name="user_follow_rel" namespace="blog.data" desc="用户关注关联表">
    <columns>
        <column name="id" type="int64" auto_increment="true" desc="主键ID"/>
        <column name="follower_id" type="int64" desc="关注者用户ID"/>
        <column name="following_id" type="int64" desc="被关注者用户ID"/>
        <column name="is_deleted" type="int32" default="0" desc="是否删除"/>
        <column name="create_time" type="datetime" default="current_timestamp" desc="关注时间"/>
        <column name="update_time" type="datetime" update="current_timestamp" desc="更新时间"/>
    </columns>
    <indexs>
        <index name="pk" cols="id" type="pk"/>
        <index name="uniq_follower_following" cols="follower_id,following_id" type="uniq"/>
        <index name="idx_follower" cols="follower_id" type="index"/>
        <index name="idx_following" cols="following_id" type="index"/>
    </indexs>
</table>
