<table name="organization" namespace="blog.data" desc="组织表">
    <columns>
        <column name="id" type="int64" auto_increment="true" desc="组织ID"/>
        <column name="name" type="string" length="100" desc="组织名称"/>
        <column name="type" type="string" length="50" desc="组织类型"/>
        <column name="description" type="string" length="500" desc="组织描述"/>
        <column name="owner_id" type="int64" desc="拥有者ID(用户ID)"/>
        <column name="status" type="int32" default="1" desc="状态: 0停用 1启用"/>
        <column name="is_deleted" type="int32" default="0" desc="是否删除"/>
        <column name="create_time" type="datetime" default="current_timestamp" desc="创建时间"/>
        <column name="update_time" type="datetime" update="current_timestamp" desc="更新时间"/>
    </columns>
    <indexs>
        <index name="pk" cols="id" type="pk"/>
        <index name="idx_owner" cols="owner_id" type="index"/>
        <index name="uniq_name" cols="name" type="uniq"/>
    </indexs>
</table>    
