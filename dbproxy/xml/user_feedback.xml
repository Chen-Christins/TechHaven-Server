<table name="user_feedback" namespace="blog.data" desc="用户反馈表">
  <columns>
    <column name="id" type="int64" auto_increment="true" desc="主键ID" />
    <column name="type" type="string" length="20" desc="反馈类型: bug/feature/other" />
    <column name="content" type="string" length="2048" desc="反馈内容" />
    <column name="contact" type="string" length="128" desc="联系方式" />
    <column name="user_id" type="int64" desc="提交用户ID" />
    <column name="is_deleted" type="int32" default="0" desc="是否删除" />
    <column name="create_time" type="datetime" default="current_timestamp" desc="创建时间" />
    <column name="update_time" type="datetime" update="current_timestamp" desc="更新时间" />
  </columns>
  <indexs>
    <index name="pk" cols="id" type="pk" />
    <index name="idx_type" cols="type" type="index" />
    <index name="idx_user_id" cols="user_id" type="index" />
  </indexs>
</table>