<table name="organization_repos" namespace="blog.data" desc="组织关联仓库表">
    <columns>
        <column name="id" type="int64" auto_increment="true" desc="主键"/>
        <column name="org_id" type="int64" desc="组织 ID，关联 organizations 表"/>
        <column name="name" type="string" length="128" desc="仓库名称，同一组织内不可重复"/>
        <column name="description" type="string" length="1024" desc="仓库描述"/>
        <column name="url" type="string" length="512" desc="仓库地址"/>
        <column name="language" type="string" length="64" desc="主要编程语言"/>
        <column name="stars_count" type="int32" default="0" desc="Star 数量（可定时同步）"/>
        <column name="sort_order" type="int32" default="0" desc="排序权重，越大越靠前"/>
        <column name="create_time" type="datetime" default="current_timestamp" desc="创建时间"/>
        <column name="update_time" type="datetime" update="current_timestamp" desc="更新时间"/>
        <column name="token" type="string" length="512" desc="仓库访问令牌, 用于 API 访问"/>
        <column name="sync_status" type="string" length="16" default="" desc="同步状态: idle/syncing/success/failed"/>
        <column name="pr_sync_status" type="string" length="16" default="" desc="PR 同步状态: idle/syncing/success/failed"/>
        <column name="pr_synced_at" type="int64" default="0" desc="上次 PR 同步时间戳"/>
        <column name="github_full_name" type="string" length="256" desc="GitHub 全称 (owner/repo)，自动从 URL 提取，用于 webhook 查找"/>
    </columns>
    <indexs>
        <index name="pk" cols="id" type="pk"/>
        <index name="idx_org_id" cols="org_id" type="index"/>
        <index name="uniq_org_name" cols="org_id,name" type="uniq"/>
    </indexs>
</table>
