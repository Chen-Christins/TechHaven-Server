<table name="comment_praise_rel" namespace="blog.data" desc="评论点赞关联表">
    <columns>
        <column name="id" type="int64" auto_increment="true" desc="主键ID"/>
        <column name="user_id" type="int64" desc="点赞用户ID"/>
        <column name="comment_id" type="int64" desc="评论ID"/>
        <column name="is_deleted" type="int32" default="0" desc="是否删除"/>
        <column name="create_time" type="datetime" desc="创建时间"/>
        <column name="update_time" type="datetime" update="current_timestamp" desc="更新时间"/>
    </columns>
    <indexs>
        <index name="pk" cols="id" type="pk"/>
        <index name="uniq_user_comment" cols="user_id,comment_id" type="uniq"/>
        <index name="idx_user" cols="user_id" type="index"/>
        <index name="idx_comment" cols="comment_id" type="index"/>
    </indexs>
</table>
