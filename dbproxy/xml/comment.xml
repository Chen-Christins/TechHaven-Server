<table name="comment" namespace="blog.data" desc="文章评论">
    <columns>
        <column name="id" type="int64" auto_increment="true" desc="评论ID"/>
        <column name="article_id" type="int64" desc="文章ID"/>
        <column name="user_id" type="int64" desc="评论用户ID"/>
        <column name="parent_id" type="int64" desc="父评论ID(0=顶级评论)"/>
        <column name="content" type="text" desc="评论内容"/>
        <column name="ip" type="string" length="64" desc="客户端IP"/>
        <column name="user_agent" type="string" length="512" desc="客户端UserAgent"/>
        <column name="status" type="int32" default="1" desc="状态 1:待审核 2:已通过 3:已拒绝 4:垃圾"/>
        <column name="is_reported" type="int32" default="0" desc="是否被举报"/>
        <column name="report_count" type="int32" default="0" desc="举报次数"/>
        <column name="is_deleted" type="int32" default="0" desc="是否删除"/>
        <column name="create_time" type="datetime" desc="创建时间"/>
        <column name="update_time" type="datetime" update="current_timestamp" desc="更新时间"/>
    </columns>
    <indexs>
        <index name="pk" cols="id" type="pk"/>
        <index name="idx_article" cols="article_id" type="index"/>
        <index name="idx_user" cols="user_id" type="index"/>
        <index name="idx_parent" cols="parent_id" type="index"/>
        <index name="idx_status" cols="status" type="index"/>
    </indexs>
</table>
