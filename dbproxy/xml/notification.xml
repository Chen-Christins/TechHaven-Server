<table name="notification" namespace="blog.data" desc="用户通知">
    <columns>
        <column name="id" type="int64" auto_increment="true" desc="主键id"/>
        <column name="user_id" type="int64" desc="接收用户id"/>
        <column name="title" type="string" length="128" desc="通知标题"/>
        <column name="content" type="text" desc="通知内容"/>
        <column name="type" type="string" length="32" desc="通知类型: system/announcement/article"/>
        <column name="sender_id" type="int64" desc="发送者id(0=系统)"/>
        <column name="article_id" type="int64" desc="关联文章ID"/>
        <column name="comment_id" type="int64" desc="关联评论ID"/>
        <column name="is_read" type="int32" default="0" desc="是否已读: 0未读 1已读"/>
        <column name="read_time" type="datetime" desc="阅读时间"/>
        <column name="is_deleted" type="int32" default="0" desc="是否删除"/>
        <column name="create_time" type="datetime" default="current_timestamp" desc="创建时间"/>
        <column name="update_time" type="datetime" default="current_timestamp" desc="更新时间"/>
        <column name="is_broadcast" type="int32" default="0" desc="是否广播: 0否 1是"/>
    </columns>
    <indexs>
        <index name="pk" cols="id" type="pk"/>
        <index name="user_id" cols="user_id" type="index"/>
        <index name="user_read" cols="user_id,is_read" type="index"/>
    </indexs>
</table>
