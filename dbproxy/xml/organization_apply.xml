<table name="organization_apply" namespace="blog.data" desc="组织创建申请表">
    <columns>
        <column name="id" type="int64" auto_increment="true" desc="申请ID"/>
        <column name="user_id" type="int64" desc="申请人用户ID"/>
        <column name="org_name" type="string" length="100" desc="组织名称"/>
        <column name="org_type" type="string" length="50" desc="组织类型"/>
        <column name="org_description" type="string" length="500" desc="组织描述"/>
        <column name="status" type="int32" default="0" desc="状态: 0待审核 1已通过 2已拒绝"/>
        <column name="review_reason" type="string" length="500" desc="审核备注"/>
        <column name="created_at" type="int64" desc="申请时间(unix timestamp)"/>
        <column name="reviewed_at" type="int64" desc="审核时间(unix timestamp)"/>
        <column name="is_deleted" type="int32" default="0" desc="是否删除"/>
    </columns>
    <indexs>
        <index name="pk" cols="id" type="pk"/>
        <index name="idx_user_id" cols="user_id" type="index"/>
        <index name="idx_status" cols="status" type="index"/>
    </indexs>
</table>
