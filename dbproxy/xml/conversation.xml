<table name="conversation" namespace="blog.data" desc="私信会话表">
    <columns>
        <column name="id" type="int64" auto_increment="true" desc="主键ID"/>
        <column name="user_a_id" type="int64" desc="参与者A用户ID(较小值)"/>
        <column name="user_b_id" type="int64" desc="参与者B用户ID(较大值)"/>
        <column name="last_message_id" type="int64" default="0" desc="最近一条消息ID(0=无消息)"/>
        <column name="last_sender_id" type="int64" default="0" desc="最近一条消息发送者ID"/>
        <column name="last_message" type="text" desc="最近一条消息内容(冗余)"/>
        <column name="last_message_time" type="int64" default="0" desc="最近一条消息时间(Unix秒)"/>
        <column name="unread_a" type="int32" default="0" desc="A未读条数"/>
        <column name="unread_b" type="int32" default="0" desc="B未读条数"/>
        <column name="is_deleted" type="int32" default="0" desc="是否删除"/>
        <column name="create_time" type="datetime" default="current_timestamp" desc="创建时间"/>
        <column name="update_time" type="datetime" default="current_timestamp" desc="更新时间"/>
        <column name="user_a_deleted" type="int32" default="0" desc="A是否在本端隐藏该会话"/>
        <column name="user_b_deleted" type="int32" default="0" desc="B是否在本端隐藏该会话"/>
    </columns>
    <indexs>
        <index name="pk" cols="id" type="pk"/>
        <index name="uniq_user_ab" cols="user_a_id,user_b_id" type="uniq"/>
        <index name="idx_user_a" cols="user_a_id" type="index"/>
        <index name="idx_user_b" cols="user_b_id" type="index"/>
    </indexs>
</table>
