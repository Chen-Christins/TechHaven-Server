<table name="category" namespace="blog.data" desc="文章分类表">
    <columns>
        <column name="id" type="int64" auto_increment="true"/>
        <column name="name" type="string" length="50"/>
		<column name="color" type="string" length="10"/>
        <column name="description" type="string" length="255"/>
        <column name="url" type="string" length="255"/>
        <column name="icon" type="string" length="255"/>
        <column name="parent_id" type="int64"/>
        <column name="status" type="int32" desc="0: 停用 1: 启用"/>
        <column name="is_deleted" type="int32"/>
        <column name="create_time" type="datetime" default="current_timestamp"/>
        <column name="update_time" type="datetime" update="current_timestamp"/>
    </columns>
    <indexs>
        <index name="pk" cols="id" type="pk"/>
        <index name="name" cols="name" type="uniq"/>
    </indexs>
</table>