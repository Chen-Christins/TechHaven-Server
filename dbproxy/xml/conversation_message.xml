<table name="conversation_message" namespace="blog.data" desc="私信消息表">
    <columns>
        <column name="id" type="int64" auto_increment="true" desc="主键ID"/>
        <column name="conversation_id" type="int64" desc="会话ID"/>
        <column name="sender_id" type="int64" desc="发送者用户ID"/>
        <column name="content" type="text" desc="消息内容"/>
        <column name="is_read" type="int32" default="0" desc="接收方是否已读: 0未读 1已读"/>
        <column name="read_time" type="int64" default="0" desc="阅读时间(Unix秒)"/>
        <column name="is_deleted" type="int32" default="0" desc="是否删除"/>
        <column name="create_time" type="datetime" default="current_timestamp" desc="创建时间"/>
        <column name="update_time" type="datetime" default="current_timestamp" desc="更新时间"/>
    </columns>
    <indexs>
        <index name="pk" cols="id" type="pk"/>
        <index name="idx_conv" cols="conversation_id" type="index"/>
        <index name="idx_conv_read" cols="conversation_id,is_read" type="index"/>
    </indexs>
</table>
