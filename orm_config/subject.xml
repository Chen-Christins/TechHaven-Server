<table name="subject" namespace="blog.data" desc="科目">
    <columns>
        <column name="id" type="int64" auto_increment="true" desc="科目id"/>
        <column name="name" type="string" length="256" desc="科目名称"/>
		<column name="color" type="string" length="10" desc="科目颜色"/>
        <column name="is_deleted" type="int32" desc="是否删除"/>
        <column name="create_time" type="datetime" desc="创建时间"/>
        <column name="update_time" type="datetime" update="current_timestamp" desc="更新时间"/>
    </columns>
    <indexs>
        <index name="pk" cols="id" type="pk"/>
		<index name="subject_name" cols="name" type="uniq"/>
    </indexs>
</table>