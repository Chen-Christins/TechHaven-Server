<table name="chunk_upload" namespace="blog.data" desc="分片上传任务表">
    <columns>
        <column name="id" type="int64" auto_increment="true" desc="主键ID"/>
        <column name="upload_id" type="string" length="64" desc="上传任务唯一ID"/>
        <column name="filename" type="string" length="256" desc="原始文件名"/>
        <column name="total_chunks" type="int32" desc="总分片数"/>
        <column name="uploaded_chunks" type="int32" desc="已上传分片数"/>
        <column name="size" type="int64" desc="文件总大小（字节）"/>
        <column name="owner_id" type="int64" desc="上传者用户ID"/>
        <column name="status" type="int32" default="1" desc="状态: 1上传中 2已完成 3失败"/>
        <column name="is_deleted" type="int32" default="0" desc="是否删除"/>
        <column name="create_time" type="datetime" default="current_timestamp" desc="创建时间"/>
        <column name="update_time" type="datetime" update="current_timestamp" desc="更新时间"/>
    </columns>
    <indexs>
        <index name="pk" cols="id" type="pk"/>
        <index name="idx_upload_id" cols="upload_id" type="uniq"/>
        <index name="idx_owner" cols="owner_id" type="index"/>
        <index name="idx_hash" cols="hash" type="index"/>
    </indexs>
</table>