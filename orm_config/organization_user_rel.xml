<table name="organization_user_rel" namespace="blog.data" desc="组织用户关联表">
    <columns>
        <column name="id" type="int64" auto_increment="true" desc="主键ID"/>
        <column name="org_id" type="int64" desc="组织ID"/>
        <column name="user_id" type="int64" desc="用户ID"/>
        <column name="role" type="int32" default="1" desc="角色: 1成员 2管理员 3拥有者"/>
        <column name="status" type="int32" default="1" desc="状态: 0申请中 1已加入 2已拒绝 3已退出"/>
        <column name="create_time" type="datetime" default="current_timestamp" desc="加入时间"/>
        <column name="update_time" type="datetime" update="current_timestamp" desc="更新时间"/>
    </columns>
    <indexs>
        <index name="pk" cols="id" type="pk"/>
        <index name="uniq_org_user" cols="org_id,user_id" type="uniq"/>
        <index name="idx_user" cols="user_id" type="index"/>
    </indexs>
</table>
