<table name="user" namespace="blog.data">
    <columns>
        <column name="id" type="int64" auto_increment="true" desc="主键id"/>
        <column name="account" type="string" desc="账户名称"/>
        <column name="email" type="string" desc="邮箱地址"/>
        <column name="passwd" type="string" desc="用户密码"/>
        <column name="name" type="string" desc="用户名"/>
        <column name="role" type="string" desc="角色"/>
        <column name="state" type="int32" desc="账号状态"/>
        <column name="login_time" type="datetime" desc="上次登录时间"/>
        <column name="is_deleted" type="int32" desc="账号是否已经删除"/>
        <column name="create_time" type="datetime" default="current_timestamp" desc="账号创建时间"/>
        <column name="update_time" type="datetime" default="current_timestamp" desc="账号信息上一次更新时间"/>
    </columns>
    <indexs>
        <index name="pk" cols="id" type="pk"/>
        <index name="account" cols="account" type="uniq"/>
        <index name="email" cols="email" type="uniq"/>
        <index name="name" cols="name" type="uniq"/>
    </indexs>
</table>