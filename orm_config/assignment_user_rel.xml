<table name="assignment_user_rel" namespace="blog.data" desc="作业-学生关联表">
    <columns>
        <column name="id" type="int64" auto_increment="true" desc="主键ID"/>
        <column name="assignment_id" type="int64" desc="作业ID"/>
        <column name="user_id" type="int64" desc="学生用户ID"/>
        <column name="status" type="int32" default="1" desc="状态: 1分配 2提交 3批改 4取消"/>
        <column name="score" type="int32" desc="成绩"/>
        <column name="submit_time" type="datetime" desc="提交时间"/>
        <column name="is_deleted" type="int32" default="0" desc="是否删除"/>
        <column name="create_time" type="datetime" default="current_timestamp" desc="创建时间"/>
        <column name="update_time" type="datetime" update="current_timestamp" desc="更新时间"/>
    </columns>
    <indexs>
        <index name="pk" cols="id" type="pk"/>
        <index name="uniq_assignment_user" cols="assignment_id,user_id" type="uniq"/>
        <index name="idx_assignment" cols="assignment_id" type="index"/>
        <index name="idx_user" cols="user_id" type="index"/>
    </indexs>
</table>
